// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model News {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String   @db.Text
  slug       String   @unique @db.Text
  category   String   @db.Text
  author     String   @default("Tim Media Desa") @db.Text
  authorRole String   @default("Pengelola Wisata") @map("author_role") @db.Text
  date       String   @db.Text
  readTime   String   @default("3 min baca") @map("read_time") @db.Text
  views      Int      @default(0)
  featured   Boolean  @default(false)
  status     String   @default("Published") @db.Text
  summary    String   @db.Text
  content    String   @db.Text
  coverImage String   @map("cover_image") @db.Text
  gallery    String[] @default([])
  videoUrl   String?  @map("video_url") @db.Text
  tags       String[] @default([])
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([category])
  @@map("news")
}

model TourismSpot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.Text
  category    String   @db.Text
  description String   @db.Text
  image       String   @db.Text
  badge       String   @db.Text
  rating      Float    @default(5.0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("tourism_spots")
}

model UmkmProduct {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.Text
  price       Int
  priceUnit   String   @map("price_unit") @db.Text
  category    String   @db.Text
  seller      String   @db.Text
  description String   @db.Text
  image       String   @db.Text
  badge       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("umkm_products")
}

model Booking {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userName      String   @map("user_name") @db.Text
  userPhone     String   @map("user_phone") @db.Text
  userEmail     String?  @map("user_email") @db.Text
  bookingDate   DateTime @map("booking_date") @db.Date
  ticketQty     Int      @default(1) @map("ticket_qty")
  tentQty       Int      @default(0) @map("tent_qty")
  guideIncluded Boolean  @default(false) @map("guide_included")
  totalPrice    Int      @map("total_price")
  notes         String?  @db.Text
  status        String   @default("Pending") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([bookingDate, status])
  @@map("bookings")
}

model VisitorReview {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.Text
  origin    String   @db.Text
  rating    Int
  date      String   @db.Text
  comment   String   @db.Text
  avatar    String?  @db.Text
  spot      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("visitor_reviews")
}

model SiteVisit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitedAt DateTime @default(now()) @map("visited_at") @db.Timestamptz()
  pagePath  String?  @default("/") @map("page_path") @db.Text
  userAgent String?  @map("user_agent") @db.Text

  @@index([visitedAt])
  @@map("site_visits")
}

model NewsComment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newsId     String   @map("news_id") @db.Text
  authorName String   @map("author_name") @db.Text
  commentText String  @map("comment_text") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([newsId])
  @@map("news_comments")
}

model Faq {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([category])
  @@map("faqs")
}

model TravelRoute {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromLocation  String   @map("from_location") @db.Text
  distance      String   @db.Text
  duration      String   @db.Text
  roadCondition String   @map("road_condition") @db.Text
  vehicleAdvice String   @map("vehicle_advice") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("travel_routes")
}

model GalleryImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String   @db.Text
  category    String   @db.Text
  imageUrl    String   @map("image_url") @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("gallery_images")
}

model VillageSetting {
  key       String   @id @db.Text
  value     String   @db.Text
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  @@map("village_settings")
}


